<div class="max-w-2xl mx-auto">
  <h1 class="text-2xl font-bold text-gray-900 mb-6">Generate Component</h1>

  <%= form_with model: @component_request, url: components_path, class: "space-y-6" do |f| %>
    <% if @component_request.errors.any? %>
      <div class="bg-red-50 border border-red-200 rounded-lg p-4">
        <ul class="text-sm text-red-800 space-y-1">
          <% @component_request.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= f.hidden_field :input_type, value: "prompt" %>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-2">Describe your component</label>
      <%= f.text_area :raw_prompt,
        rows: 6,
        class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500 text-sm",
        placeholder: "Create a responsive card component with an image, title, description, and action buttons. It should support dark mode and have hover animations..." %>
      <p class="mt-1 text-xs text-gray-500">Be as specific as possible about props, events, slots, and styling preferences.</p>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-2">Target Frameworks</label>
      <div class="flex gap-4">
        <label class="inline-flex items-center">
          <%= check_box_tag "component_request[target_frameworks][]", "vue", true, class: "rounded border-gray-300 text-green-600 focus:ring-green-500" %>
          <span class="ml-2 text-sm text-gray-700">Vue 3</span>
        </label>
        <label class="inline-flex items-center">
          <%= check_box_tag "component_request[target_frameworks][]", "svelte", true, class: "rounded border-gray-300 text-green-600 focus:ring-green-500" %>
          <span class="ml-2 text-sm text-gray-700">Svelte</span>
        </label>
      </div>
    </div>

    <div class="flex items-center justify-end gap-3 pt-4 border-t">
      <%= link_to "Cancel", components_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
      <%= f.submit "Generate Component",
        class: "bg-green-600 hover:bg-green-700 text-white px-6 py-2.5 rounded-lg text-sm font-medium cursor-pointer transition-colors" %>
    </div>
  <% end %>
</div>
