<div class="bg-white shadow rounded-lg p-6">
  <div class="flex items-center justify-between mb-2">
    <span class="text-sm font-medium text-gray-700">Overall Progress</span>
    <span class="text-sm font-semibold text-gray-900"><%= pipeline_run.progress_percentage %>%</span>
  </div>
  <div class="w-full bg-gray-200 rounded-full h-3">
    <div class="bg-green-500 h-3 rounded-full transition-all duration-500 ease-out"
         style="width: <%= pipeline_run.progress_percentage %>%">
    </div>
  </div>
  <div class="flex items-center justify-between mt-2 text-xs text-gray-500">
    <span>Stage <%= pipeline_run.current_stage %> of <%= pipeline_run.total_stages %></span>
    <% if pipeline_run.duration %>
      <span><%= "%.1f" % pipeline_run.duration %>s elapsed</span>
    <% end %>
  </div>
</div>
