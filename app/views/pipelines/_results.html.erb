<div class="bg-white shadow rounded-lg p-6">
  <div class="flex items-center gap-2 mb-4">
    <svg class="h-5 w-5 text-green-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
    </svg>
    <h2 class="text-lg font-semibold text-gray-900">Pipeline Complete!</h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <% pipeline_run.generated_components.each do |component| %>
      <div class="border rounded-lg p-4">
        <div class="flex items-center justify-between mb-2">
          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium
            <%= component.framework == 'vue' ? 'bg-emerald-100 text-emerald-800' : 'bg-orange-100 text-orange-800' %>">
            <%= component.framework.capitalize %>
          </span>
          <span class="text-xs text-gray-500"><%= component.filename %></span>
        </div>
        <%= link_to "View Source", component_path(pipeline_run.component_request),
          class: "text-sm text-green-600 hover:text-green-700 font-medium" %>
      </div>
    <% end %>
  </div>
</div>
