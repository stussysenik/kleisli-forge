<!DOCTYPE html>
<html class="h-full bg-gray-50">
  <head>
    <title><%= content_for(:title) || "NIM Component Engine" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="NIM Component Engine">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full">
    <nav class="bg-gray-900 shadow-lg">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center gap-3">
            <%= link_to root_path, class: "flex items-center gap-2" do %>
              <div class="w-8 h-8 bg-green-500 rounded-lg flex items-center justify-center">
                <span class="text-white font-bold text-sm">N</span>
              </div>
              <span class="text-white font-semibold text-lg">NIM Component Engine</span>
            <% end %>
            <% if user_signed_in? %>
              <div class="flex items-center gap-4 ml-8">
                <%= link_to "Dashboard", components_path, class: "text-gray-300 hover:text-white text-sm" %>
                <%= link_to "New Component", new_component_path, class: "text-gray-300 hover:text-white text-sm" %>
              </div>
            <% end %>
          </div>
          <div class="flex items-center gap-4">
            <% if user_signed_in? %>
              <span class="text-gray-400 text-sm"><%= current_user.email %></span>
              <%= link_to "Sign out", destroy_user_session_path, data: { turbo_method: :delete }, class: "text-gray-400 hover:text-white text-sm" %>
            <% else %>
              <%= link_to "Sign in", new_user_session_path, class: "text-gray-300 hover:text-white text-sm" %>
              <%= link_to "Sign up", new_user_registration_path, class: "bg-green-600 hover:bg-green-700 text-white px-3 py-1.5 rounded-md text-sm" %>
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <% if notice.present? %>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
        <div class="bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-lg text-sm">
          <%= notice %>
        </div>
      </div>
    <% end %>

    <% if alert.present? %>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
        <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-lg text-sm">
          <%= alert %>
        </div>
      </div>
    <% end %>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <%= yield %>
    </main>
  </body>
</html>
